# Nebius Token Factory (OpenAI-compatible)
# Get a key at https://tokenfactory.nebius.com/
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model IDs on Token Factory (Nemotron family)
NEBIUS_MODEL_NANO=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEBIUS_MODEL_SUPER=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b

# Dry-run / mock mode: set to 1 to run without a real API key
REPOFORGE_DRY_RUN=1

# Optional: Tavily web research ($3k bonus track) — stubbed in MVP
TAVILY_API_KEY=

# Server
REPOFORGE_HOST=127.0.0.1
REPOFORGE_PORT=8000
